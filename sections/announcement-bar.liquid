{% if section.settings.text != blank %}<aside class="announcement" style="--announcement-bg:{{ section.settings.background }};--announcement-text:{{ section.settings.text_color }}"><div class="page-width">{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}{{ section.settings.text }}{% if section.settings.link != blank %}</a>{% endif %}</div></aside>{% endif %}
{% stylesheet %}.announcement{padding:.55rem 0;text-align:center;background:var(--announcement-bg);color:var(--announcement-text);font-size:.9rem}.announcement a{text-decoration:none}{% endstylesheet %}
{% schema %}{"name":"Announcement bar","settings":[{"type":"text","id":"text","label":"Text","default":"Welcome to our store"},{"type":"url","id":"link","label":"Link"},{"type":"color","id":"background","label":"Background","default":"#f97316"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"}],"presets":[{"name":"Announcement bar"}]}{% endschema %}
