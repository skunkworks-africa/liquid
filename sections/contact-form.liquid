<section class="section"><div class="page-width stack"><h1>{{ page.title }}</h1>{% form 'contact' %}{{ form.errors | default_errors }}<div class="stack"><label>{{ 'contact.name' | t }}<input class="field" type="text" name="contact[name]"></label><label>{{ 'contact.email' | t }}<input class="field" type="email" name="contact[email]" required></label><label>{{ 'contact.phone' | t }}<input class="field" type="tel" name="contact[phone]"></label><label>{{ 'contact.message' | t }}<textarea class="field" name="contact[body]" rows="8" required></textarea></label><button class="button" type="submit">{{ 'contact.send' | t }}</button></div>{% endform %}</div></section>{% schema %}{"name":"Contact form","settings":[],"presets":[{"name":"Contact form"}]}{% endschema %}
