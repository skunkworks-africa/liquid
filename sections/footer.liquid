<footer class="site-footer"><div class="page-width footer__grid"><div><h2>{{ shop.name }}</h2><div class="muted">{{ section.settings.text }}</div></div><div><h2>{{ section.settings.menu_title }}</h2><ul>{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></div><div><h2>{{ 'footer.newsletter' | t }}</h2>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="FooterEmail">{{ 'footer.email' | t }}</label><input class="field" id="FooterEmail" type="email" name="contact[email]" required placeholder="{{ 'footer.email' | t }}"><button class="button" type="submit">{{ 'footer.subscribe' | t }}</button>{% endform %}</div></div><div class="page-width footer__bottom">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ powered_by_link }}</div></footer>
{% stylesheet %}.site-footer{padding-block:3rem 1.5rem;background:var(--color-brand);color:#fff}.footer__grid{display:grid;grid-template-columns:2fr 1fr 2fr;gap:2rem}.site-footer ul{padding:0;list-style:none}.site-footer form{display:flex;gap:.5rem}.footer__bottom{padding-top:2rem;margin-top:2rem;border-top:1px solid #ffffff33}@media(max-width:749px){.footer__grid{grid-template-columns:1fr}.site-footer form{flex-direction:column}}{% endstylesheet %}
{% schema %}{"name":"Footer","settings":[{"type":"richtext","id":"text","label":"About","default":"<p>A Skunkworks online store.</p>"},{"type":"text","id":"menu_title","label":"Menu heading","default":"Explore"},{"type":"link_list","id":"menu","label":"Menu","default":"footer"}]}{% endschema %}
