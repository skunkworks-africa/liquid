<header class="site-header"><div class="page-width header__inner">
  <button class="menu-toggle" data-menu-toggle aria-controls="PrimaryNav" aria-expanded="false"><span class="visually-hidden">{{ 'accessibility.menu' | t }}</span>☰</button>
  <a class="brand" href="{{ routes.root_url }}">{% if settings.logo %}{{ settings.logo | image_url: width: 360 | image_tag: widths: '180, 360', alt: shop.name }}{% else %}{{ shop.name }}{% endif %}</a>
  <nav id="PrimaryNav" class="nav" aria-label="{{ 'accessibility.menu' | t }}"><ul>{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></nav>
  <div class="header__actions"><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a><a href="{{ routes.cart_url }}">{{ 'cart.title' | t }} ({{ cart.item_count }})</a></div>
</div></header>
{% stylesheet %}.site-header{position:sticky;top:0;z-index:20;border-bottom:1px solid color-mix(in srgb,var(--color-text) 12%,transparent);background:color-mix(in srgb,var(--color-background) 94%,transparent);backdrop-filter:blur(12px)}.header__inner{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1.5rem;min-height:4.5rem}.brand{font-weight:800;text-decoration:none}.brand img{max-height:2.75rem;width:auto}.nav ul{display:flex;gap:1.2rem;margin:0;padding:0;list-style:none}.nav a,.header__actions a{text-decoration:none}.header__actions{display:flex;gap:1rem}.menu-toggle{display:none;background:transparent;border:0;font-size:1.5rem}@media(max-width:749px){.header__inner{grid-template-columns:auto 1fr auto}.menu-toggle{display:block}.nav{grid-column:1/-1}.nav[hidden]{display:none}.nav ul{display:grid;padding-bottom:1rem}.header__actions a:first-child{display:none}}{% endstylesheet %}
{% schema %}{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}{% endschema %}
