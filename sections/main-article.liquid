<article class="section"><div class="page-width article stack"><header><p class="muted">{{ article.published_at | date: format: 'date' }}</p><h1>{{ article.title }}</h1></header>{% if article.image %}{{ article.image | image_url: width: 1800 | image_tag: widths: '750, 1100, 1500, 1800', sizes: 'min(100vw, 900px)', alt: article.image.alt }}{% endif %}<div>{{ article.content }}</div></div></article>
{% stylesheet %}.article{max-width:56rem}.article h1{font-size:clamp(2.25rem,6vw,4.5rem);line-height:1.1}{% endstylesheet %}
{% schema %}{"name":"Main article","settings":[]}{% endschema %}
