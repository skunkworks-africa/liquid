<section class="section"><div class="page-width stack"><h1>{{ blog.title }}</h1>{% paginate blog.articles by section.settings.articles_per_page %}<div class="grid">{% for article in blog.articles %}<article class="card">{% if article.image %}<a href="{{ article.url }}">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw', alt: article.image.alt }}</a>{% endif %}<div class="card__content"><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p class="muted">{{ article.published_at | date: format: 'date' }}</p><p>{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p></div></article>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</div></section>
{% schema %}{"name":"Main blog","settings":[{"type":"range","id":"articles_per_page","label":"Articles per page","min":3,"max":24,"step":3,"default":9}]}{% endschema %}
