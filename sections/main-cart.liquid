<section class="section"><div class="page-width stack"><h1>{{ 'cart.title' | t }}</h1>{% if cart.empty? %}<p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>{% else %}{% form 'cart', cart %}<div class="stack">{% for item in cart.items %}<article class="cart-item"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.image.alt }}{% endif %}</a><div><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2><label for="Quantity-{{ item.index }}">Quantity</label><input class="field" id="Quantity-{{ item.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div><div class="cart-summary"><p>{{ 'cart.subtotal' | t }}: <strong>{{ cart.total_price | money }}</strong></p><button class="button button--secondary" type="submit" name="update">{{ 'cart.update' | t }}</button><button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button></div>{% endform %}{% endif %}</div></section>
{% stylesheet %}.cart-item{display:grid;grid-template-columns:8rem 1fr auto;gap:1rem;align-items:center;padding-block:1rem;border-bottom:1px solid #0002}.cart-summary{text-align:right;margin-top:2rem}.cart-summary .button{margin-left:.5rem}{% endstylesheet %}
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
