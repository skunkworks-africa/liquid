<section class="section"><div class="page-width stack"><h1>{{ section.settings.heading }}</h1><div class="grid">{% for collection in collections %}<article class="card"><a href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw', alt: collection.featured_image.alt }}{% endif %}</a><div class="card__content"><h2><a href="{{ collection.url }}">{{ collection.title }}</a></h2></div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Collection list","settings":[{"type":"text","id":"heading","label":"Heading","default":"Collections"}]}{% endschema %}
