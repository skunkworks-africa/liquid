<section class="section"><div class="page-width product-layout"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 55vw, 100vw', alt: product.featured_image.alt }}{% endif %}</div><div class="stack"><h1>{{ product.title }}</h1><div class="price">{{ product.selected_or_first_available_variant.price | money }}</div><div>{{ product.description }}</div>{% form 'product', product %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</button>{% endform %}</div></div></section>
{% stylesheet %}.product-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(18rem,.8fr);gap:clamp(2rem,6vw,5rem)}@media(max-width:749px){.product-layout{grid-template-columns:1fr}}{% endstylesheet %}
{% schema %}{"name":"Main product","settings":[]}{% endschema %}
