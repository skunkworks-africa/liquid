<section class="section"><div class="page-width stack"><h1>{{ 'general.search' | t }}</h1><form action="{{ routes.search_url }}" method="get" role="search" class="cluster"><label class="visually-hidden" for="SearchInput">{{ 'general.search' | t }}</label><input class="field" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}"><input type="hidden" name="options[prefix]" value="last"><button class="button" type="submit">{{ 'general.search' | t }}</button></form>{% if search.performed %}{% paginate search.results by 24 %}<div class="grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<article class="card"><div class="card__content"><h2><a href="{{ item.url }}">{{ item.title }}</a></h2><p>{{ item.content | strip_html | truncate: 180 }}</p></div></article>{% endif %}{% else %}<p>{{ 'general.no_results' | t }}</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</div></section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}
