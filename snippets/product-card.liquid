{% doc %}
Renders a product card.
@param {product} product - Product to display.
{% enddoc %}
<article class="card">
  <a href="{{ product.url }}">
    {% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '320, 480, 720', sizes: '(min-width: 750px) 33vw, 100vw', alt: product.featured_image.alt }}{% endif %}
  </a>
  <div class="card__content stack">
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <span class="price">{% if product.price_varies %}{{ 'products.from_price' | t: price: product.price_min | money }}{% else %}{{ product.price | money }}{% endif %}</span>
  </div>
</article>
